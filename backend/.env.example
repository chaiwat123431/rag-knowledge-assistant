# Embeddings run locally via sentence-transformers — no key needed.
#
# LLM: Ollama locally for development (no key); Google Gemini API (Flash,
# free tier) for production/deployment. Set this only for the prod path.
GEMINI_API_KEY=your_key_here

# Which LLM backend app/api/routes.py's get_llm() selects: "ollama"
# (default if unset, local dev) or "gemini" (production; needs
# GEMINI_API_KEY above). Any other value fails loudly at request time
# rather than silently falling back to a default. NOTE: like any
# python-dotenv value, an inline "# comment" is only stripped when
# there's a space before the "#" — LLM_PROVIDER=gemini#note becomes the
# literal value "gemini#note", not "gemini". Put comments on their own
# line, as above, to avoid this entirely.
LLM_PROVIDER=ollama

# Comma-separated origins allowed to call the API from a browser (CORS).
# Defaults to the Next.js dev server if unset.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# CPU-thread limits for onnxruntime/tokenizers on a small, low-vCPU
# deploy target (e.g. Render's 512MB Starter plan). Measured locally
# (8 runs each, with vs. without): no reliable effect on peak memory --
# run-to-run variance (~20MB) dwarfs any difference these make. This held
# both before and after the embeddings.py ONNX migration (see
# PLANNING.md for the measurements behind that separate, much larger
# change). They only cap how many OpenMP/BLAS threads get spawned, which
# avoids CPU thrashing/contention on a constrained instance under
# concurrent requests. Harmless to set regardless; must be present in the
# process environment before the first request lazily imports
# onnxruntime/tokenizers (which is why load_dotenv() in main.py, at
# module top level, runs early enough for these to take effect locally --
# on Render itself, set them as real dashboard environment variables, not
# via this file, since Render doesn't read backend/.env from the repo).
OMP_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false
